{
	"name": "pi-suite",
	"version": "0.1.0",
	"description": "An opinionated Pi coding agent distribution for an AmpCode-level developer experience.",
	"type": "module",
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "shx rm -rf dist coverage",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "biome check --error-on-warnings . && pnpm typecheck && pnpm test",
		"check:fix": "biome check --write --error-on-warnings .",
		"prepublishOnly": "pnpm clean && pnpm check && pnpm build"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@earendil-works/pi-ai": "0.81.1",
		"@earendil-works/pi-coding-agent": "0.81.1",
		"@types/node": "22.19.19",
		"shx": "0.4.0",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-coding-agent",
		"compaction",
		"developer-experience",
		"llm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Hopsken/pi-suite.git"
	},
	"homepage": "https://github.com/Hopsken/pi-suite#readme",
	"bugs": {
		"url": "https://github.com/Hopsken/pi-suite/issues"
	},
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "pnpm@11.15.1"
}
